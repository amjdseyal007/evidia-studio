# Evidia Studio — platform console (apps/studio)
#
# Vite exposes only VITE_-prefixed vars to the browser. Copy this file to
# .env.local (do NOT commit real values) and restart `npm run dev` after
# changing them — Vite reads env at startup, not runtime.
#
# Mode switch (single seam: src/lib/api.ts)
#   mock (DEFAULT) — fixtures + fake-JWT seam; no network; no other vars needed.
#   live           — fetch FastAPI Studio API with a Cognito JWT.
VITE_EVIDIA_API_MODE=mock

# --- Required when VITE_EVIDIA_API_MODE=live (all three are mandatory) ---
# Base URL of the deployed FastAPI Studio API (no trailing slash needed).
VITE_EVIDIA_API_BASE_URL=
# Cognito user pool for the Studio API JWT authorizer (e.g. us-east-1_xxxxxxxxx).
VITE_COGNITO_USER_POOL_ID=
# Cognito app client id for that pool (the console still reads the access/ID
# token from the existing auth seam in src/lib/auth.ts).
VITE_COGNITO_CLIENT_ID=

# Example live block:
# VITE_EVIDIA_API_MODE=live
# VITE_EVIDIA_API_BASE_URL=https://api.evidia.example.com
# VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=0123456789abcdefghijklmnop
